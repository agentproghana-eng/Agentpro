<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration for AgentPro.
    Enforces HTTPS-only production connections using Android's trusted
    system certificate authorities.
    Local development endpoints may use cleartext traffic.
-->
<network-security-config>

    <!-- Production API: enforce HTTPS with system CA validation -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.agentpro.intellicoresystem.com</domain>

        <!--
            TLS is validated against Android's trusted system CA store.

            Certificate pinning is intentionally not used because the
            production API is hosted behind Render-managed TLS. Render
            automatically renews certificates and may use different trusted
            certificate authorities, so static application pins could cause
            production outages during normal certificate rotation.
        -->
    </domain-config>

    <!-- Cloudinary: HTTPS only -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">res.cloudinary.com</domain>
        <domain includeSubdomains="true">cloudinary.com</domain>
    </domain-config>

    <!-- Firebase: HTTPS only -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">firebase.google.com</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">fcm.googleapis.com</domain>
    </domain-config>

    <!-- Local development only (debug builds) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- Default: no cleartext -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
